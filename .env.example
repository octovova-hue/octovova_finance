# ====================================================================
# Octovova Finance Planning Engine — Environment Variables
# ====================================================================

# PostgreSQL / Supabase Connection
# If using Supabase or PostgREST, fill these in to connect live to PostgreSQL:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Direct PostgreSQL Connection String (for Backend / Migrations / Prisma / Drizzle)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/octovova_db

# Optional AI Key Settings
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
