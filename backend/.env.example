# ====================================================================
# Octovova Finance Planning Engine — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ====================================================================

# ── Database (Supabase Postgres) ─────────────────────────────────────
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── JWT Authentication ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Hugging Face Monte Carlo Static API ──────────────────────────────
# Public Space — no token needed. Fill HF_API_TOKEN if Space goes private.
HF_MONTE_CARLO_URL=https://octovova-nifty50-monte-carlo-api.static.hf.space
HF_API_TOKEN=

# ── LLM Hub (OpenRouter — OpenAI-compatible) ──────────────────────────
LLM_HUB_URL=https://openrouter.ai/api/v1
LLM_HUB_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY
LLM_HUB_MODEL=anthropic/claude-sonnet-4-5
LLM_HUB_REFERER=https://octovova.finance
LLM_HUB_TITLE=Octovova Finance Planning Engine

# ── CORS (comma-separated, no trailing slash) ─────────────────────────
# Add your production frontend URL here
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Financial Engine Defaults ─────────────────────────────────────────
DEFAULT_INFLATION_RATE=0.06
DEFAULT_BUFFER_PCT=0.10
DEFAULT_EMERGENCY_MONTHS=6

# ── AI Guardrail Settings ─────────────────────────────────────────────
AI_MAX_RETRIES=1
NUMERIC_TOLERANCE_PCT=0.5
